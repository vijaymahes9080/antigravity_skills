{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentProductionSpec",
  "type": "object",
  "required": ["metadata", "design", "content"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "format"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "author": { "type": "string" },
        "organization": { "type": "string" },
        "date": { "type": "string" },
        "format": { "type": "string", "enum": ["docx", "pptx", "xlsx", "pdf", "html", "svg", "rtf", "md"] }
      }
    },
    "design": {
      "type": "object",
      "required": ["archetype"],
      "properties": {
        "archetype": {
          "type": "string",
          "enum": [
            "modern_corporate",
            "minimalist_editorial",
            "academic_scientific",
            "premium_business",
            "technology_futuristic",
            "creative_experimental",
            "government_institutional",
            "engineering_technical",
            "educational_instructional",
            "magazine_publication",
            "luxury_hospitality",
            "data_analytical"
          ]
        },
        "primary_color": { "type": "string" },
        "secondary_color": { "type": "string" },
        "accent_color": { "type": "string" }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "level": { "type": "integer", "default": 1 },
              "paragraphs": { "type": "array", "items": { "type": "string" } },
              "callout": { "type": "string" },
              "table": {
                "type": "object",
                "properties": {
                  "headers": { "type": "array", "items": { "type": "string" } },
                  "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
                }
              },
              "code_block": {
                "type": "object",
                "properties": {
                  "language": { "type": "string" },
                  "code": { "type": "string" }
                }
              }
            }
          }
        },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "title"],
            "properties": {
              "type": { "type": "string" },
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "bullets": { "type": "array", "items": { "type": "string" } },
              "cards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "header": { "type": "string" },
                    "body": { "type": "string" },
                    "stat": { "type": "string" }
                  }
                }
              },
              "notes": { "type": "string" }
            }
          }
        },
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "tables"],
            "properties": {
              "name": { "type": "string" },
              "tables": { "type": "array" }
            }
          }
        }
      }
    }
  }
}
